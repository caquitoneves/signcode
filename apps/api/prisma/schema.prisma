generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// Auth (Incremento 2)
// ==========================================================

enum Role {
  STUDENT
  ADMIN
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?
  role          Role      @default(STUDENT)
  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  profile            Profile?
  enrollments    Enrollment[]
  lessonProgress      LessonProgress[]
  exerciseSubmissions ExerciseSubmission[]
  challengeSubmissions ChallengeSubmission[]
  projectSubmissions   ProjectSubmission[]
  checkpointAttempts   CheckpointAttempt[]
  assessmentResponses  AssessmentResponse[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?
  rememberMe Boolean  @default(false)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Profile {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  username     String?
  bio          String?
  pronouns     String?
  city         String?
  learningGoal String?
  theme        String  @default("violet")
  emailReminders        Boolean @default(true)
  weeklySummary         Boolean @default(true)
  courseRecommendations Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// ==========================================================
// Conteúdo (Incremento 3) — Libras é 1ª classe via languageCode
// ==========================================================

enum CourseStatus {
  DRAFT
  PUBLISHED
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  status      CourseStatus @default(DRAFT)
  order       Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules     Module[]
  enrollments Enrollment[]
  assessment  Assessment?
  projects    Project[]

  @@map("courses")
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons     Lesson[]
  challenges  Challenge[]
  projects    Project[]
  checkpoint  Checkpoint?

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id              String @id @default(cuid())
  moduleId        String
  module          Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug            String
  order           Int    @default(0)
  durationSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations LessonTranslation[]
  videos       LessonVideo[]
  materials    LessonMaterial[]
  progress     LessonProgress[]
  exercises    Exercise[]
  challenges   Challenge[]

  @@unique([moduleId, slug])
  @@index([moduleId])
  @@map("lessons")
}

model LessonTranslation {
  id           String   @id @default(cuid())
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  languageCode String
  title        String
  summary      String?
  bodyMarkdown String?
  caption      String?
  transcript   String?
  objectives   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, languageCode])
  @@index([lessonId])
  @@map("lesson_translations")
}

enum LessonVideoRole {
  CONTENT
  INSTRUCTOR
  INTERPRETER
}

model LessonVideo {
  id              String @id @default(cuid())
  lessonId        String
  lesson          Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  languageCode    String
  role            LessonVideoRole @default(CONTENT)
  provider        String
  externalId      String
  durationSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, role])
  @@index([lessonId])
  @@map("lesson_videos")
}

model LessonMaterial {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title    String
  url      String
  order    Int    @default(0)

  createdAt DateTime @default(now())

  @@index([lessonId])
  @@map("lesson_materials")
}

// ==========================================================
// Progresso (Incremento 5)
// ==========================================================

model Enrollment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ==========================================================
// Exercícios (Incremento 6) — Exercise -> Evaluator
// CODE (execução isolada) entra no futuro como serviço separado.
// ==========================================================

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_BLANK
}

model Exercise {
  id              String       @id @default(cuid())
  lessonId        String
  lesson          Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order           Int          @default(0)
  type            ExerciseType
  prompt          String
  explanation     String?
  acceptedAnswers String[] // usado por FILL_BLANK

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options     ExerciseOption[]
  submissions ExerciseSubmission[]

  @@index([lessonId])
  @@map("exercises")
}

model ExerciseOption {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([exerciseId])
  @@map("exercise_options")
}

model ExerciseSubmission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  answer     String // optionId escolhido ou texto respondido
  isCorrect  Boolean

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([exerciseId])
  @@map("exercise_submissions")
}


// ==========================================================
// Experiência de aprendizagem (Incremento 8)
// Tipos de conteúdo além da aula: Desafio, Projeto, Checkpoint, Diagnóstico.
// ==========================================================

enum ProjectKind {
  MINI
  FINAL
}

enum AssessmentPhase {
  BEFORE
  AFTER
}

enum AssessmentQuestionKind {
  SINGLE_CHOICE
  TEXT
  SCALE
}

// Desafio de código como entidade de 1ª classe (item do módulo e/ou ligado a uma aula).
model Challenge {
  id           String  @id @default(cuid())
  moduleId     String
  module       Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonId     String?
  lesson       Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  order        Int     @default(0)
  title        String
  instructions String
  starterCode  String
  tests        Json // [{ description, assert }]
  languageCode String  @default("js")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions ChallengeSubmission[]

  @@index([moduleId])
  @@index([lessonId])
  @@map("challenges")
}

model ChallengeSubmission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  code        String
  passed      Boolean

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([challengeId])
  @@map("challenge_submissions")
}

// Projeto (mini durante o curso, ou o projeto final) — vai para o portfólio.
model Project {
  id           String      @id @default(cuid())
  kind         ProjectKind @default(MINI)
  moduleId     String?
  module       Module?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order        Int         @default(0)
  title        String
  brief        String // Markdown
  requirements String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions ProjectSubmission[]

  @@index([moduleId])
  @@index([courseId])
  @@map("projects")
}

model ProjectSubmission {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repoUrl   String?
  liveUrl   String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("project_submissions")
}

// Checkpoint de fim de módulo (quiz + explicação das respostas).
model Checkpoint {
  id          String  @id @default(cuid())
  moduleId    String  @unique
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions CheckpointQuestion[]
  attempts  CheckpointAttempt[]

  @@map("checkpoints")
}

model CheckpointQuestion {
  id           String @id @default(cuid())
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  order        Int    @default(0)
  prompt       String
  explanation  String?

  options CheckpointOption[]

  @@index([checkpointId])
  @@map("checkpoint_questions")
}

model CheckpointOption {
  id         String  @id @default(cuid())
  questionId String
  question   CheckpointQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int     @default(0)
  text       String
  isCorrect  Boolean @default(false)

  @@index([questionId])
  @@map("checkpoint_options")
}

model CheckpointAttempt {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  score        Int
  total        Int
  passed       Boolean

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([checkpointId])
  @@map("checkpoint_attempts")
}

// Avaliação diagnóstica do curso ("Antes de começar"), aplicada antes e depois (piloto).
model Assessment {
  id          String  @id @default(cuid())
  courseId    String  @unique
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions AssessmentQuestion[]
  responses AssessmentResponse[]

  @@map("assessments")
}

model AssessmentQuestion {
  id           String @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  order        Int    @default(0)
  kind         AssessmentQuestionKind @default(SINGLE_CHOICE)
  prompt       String

  options AssessmentOption[]

  @@index([assessmentId])
  @@map("assessment_questions")
}

model AssessmentOption {
  id         String @id @default(cuid())
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int    @default(0)
  text       String

  @@index([questionId])
  @@map("assessment_options")
}

model AssessmentResponse {
  id           String @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phase        AssessmentPhase @default(BEFORE)
  answers      Json // { [questionId]: optionId | texto | escala }

  createdAt DateTime @default(now())

  @@unique([userId, assessmentId, phase])
  @@index([assessmentId])
  @@map("assessment_responses")
}
