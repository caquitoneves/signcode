generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// Auth (Incremento 2)
// ==========================================================

enum Role {
  STUDENT
  ADMIN
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?
  role         Role    @default(STUDENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  enrollments    Enrollment[]
  lessonProgress      LessonProgress[]
  exerciseSubmissions ExerciseSubmission[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ==========================================================
// Conteúdo (Incremento 3) — Libras é 1ª classe via languageCode
// ==========================================================

enum CourseStatus {
  DRAFT
  PUBLISHED
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  status      CourseStatus @default(DRAFT)
  order       Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules     Module[]
  enrollments Enrollment[]

  @@map("courses")
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id              String @id @default(cuid())
  moduleId        String
  module          Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug            String
  order           Int    @default(0)
  durationSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations LessonTranslation[]
  videos       LessonVideo[]
  materials    LessonMaterial[]
  progress     LessonProgress[]
  exercises    Exercise[]

  @@unique([moduleId, slug])
  @@index([moduleId])
  @@map("lessons")
}

model LessonTranslation {
  id           String   @id @default(cuid())
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  languageCode String
  title        String
  summary      String?
  bodyMarkdown String?
  caption      String?
  transcript   String?
  objectives   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, languageCode])
  @@index([lessonId])
  @@map("lesson_translations")
}

enum LessonVideoRole {
  CONTENT
  INSTRUCTOR
  INTERPRETER
}

model LessonVideo {
  id              String @id @default(cuid())
  lessonId        String
  lesson          Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  languageCode    String
  role            LessonVideoRole @default(CONTENT)
  provider        String
  externalId      String
  durationSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, role])
  @@index([lessonId])
  @@map("lesson_videos")
}

model LessonMaterial {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title    String
  url      String
  order    Int    @default(0)

  createdAt DateTime @default(now())

  @@index([lessonId])
  @@map("lesson_materials")
}

// ==========================================================
// Progresso (Incremento 5)
// ==========================================================

model Enrollment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ==========================================================
// Exercícios (Incremento 6) — Exercise -> Evaluator
// CODE (execução isolada) entra no futuro como serviço separado.
// ==========================================================

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_BLANK
}

model Exercise {
  id              String       @id @default(cuid())
  lessonId        String
  lesson          Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order           Int          @default(0)
  type            ExerciseType
  prompt          String
  explanation     String?
  acceptedAnswers String[] // usado por FILL_BLANK

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options     ExerciseOption[]
  submissions ExerciseSubmission[]

  @@index([lessonId])
  @@map("exercises")
}

model ExerciseOption {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([exerciseId])
  @@map("exercise_options")
}

model ExerciseSubmission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  answer     String // optionId escolhido ou texto respondido
  isCorrect  Boolean

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([exerciseId])
  @@map("exercise_submissions")
}
