# ==========================================================
# Projeto X — variáveis de ambiente (exemplo)
# Copie para .env e ajuste. NUNCA commite o .env real.
# ==========================================================

# --- Banco de dados (Postgres via docker-compose) ---
POSTGRES_USER=projetox
POSTGRES_PASSWORD=projetox_dev
POSTGRES_DB=projetox
POSTGRES_PORT=5432
DATABASE_URL="postgresql://projetox:projetox_dev@localhost:5432/projetox?schema=public"

# --- API (NestJS) ---
API_PORT=3333
API_CORS_ORIGIN=http://localhost:3000

# --- Auth (Incremento 2 — placeholders por enquanto) ---
# Gere segredos fortes: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3333
